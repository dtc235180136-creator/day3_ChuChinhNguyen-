@model b3_chuchinhnguyen.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<h1>Xóa sản phẩm</h1>
<h3>Bạn có chắc muốn xóa sản phẩm này không?</h3>
<hr />
<dl class="row">
    <dt class="col-sm-3">Tên sản phẩm</dt>
    <dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Giá</dt>
    <dd class="col-sm-9">@Model.Price.ToString("N0")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="ID" type="hidden" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
